# KineticMesh Environment Configuration
# Google Gemini API key from Google AI Studio: https://aistudio.google.com/
# Keep this secret; never commit real credentials to source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_ITERATIONS=3
# Optional comma-separated list of allowed origins for cross-origin access
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
